# MedFlow-IA — Variáveis de ambiente (templates)
#
# Ambientes (Vite carrega por modo; último arquivo vence):
#   desenvolvimento  → .env.local          (npm run dev)
#   staging          → .env.staging        (npm run build:staging)
#   produção         → .env.production     (npm run build)
#
# Copie o exemplo correspondente e preencha valores reais apenas localmente
# ou no painel de deploy — nunca commite secrets.
#
#   cp .env.example .env.local
#   cp .env.staging.example .env.staging
#   cp .env.production.example .env.production

# --- Públicas (bundle Vite — prefixo VITE_) ---

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Desenvolvimento local (opcional)
# Dev local:
# VITE_MEDFLOW_APP_URL=http://localhost:8080
# Staging (npm run build:staging — ver .env.staging.example):
# VITE_MEDFLOW_APP_URL=https://staging.medicflow.app.br

# Staging / produção — domínio institucional (HTTPS)
# VITE_MEDFLOW_APP_URL=https://app.seudominio.com.br
# VITE_MEDFLOW_CONTACT_EMAIL=contato@seudominio.com.br

# Opcional: diagnóstico (evite em staging/produção com usuários reais)
# VITE_MEDFLOW_DEBUG=1

# Opcional: error tracking externo (Sentry, Datadog, etc.) — sink em lib/monitoring/sinks/error-tracker.ts
# VITE_MEDFLOW_ERROR_TRACKING_DSN=
# MEDFLOW_ERROR_TRACKING_DSN=

# --- Servidor (SSR / Workers — SEM prefixo VITE_) ---

# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# MEDFLOW_AUDIT_HASH_SALT=random_long_secret
# MEDFLOW_OPENAI_API_KEY=sk-...
# MEDFLOW_OPENAI_MODEL=gpt-4o-mini
