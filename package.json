{
  "name": "medflow-ia",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/clear-staging-build-marker.mjs && vite build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "build:staging": "vite build --mode staging && node scripts/write-staging-build-marker.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "deploy:preview": "npm run build && wrangler deploy --dry-run",
    "deploy:staging:preview": "node scripts/deploy-staging.mjs --dry-run",
    "validate-staging-build": "node scripts/validate-staging-build.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "env-check": "node scripts/env-check.mjs",
    "env-check:staging": "node scripts/env-check.mjs --staging",
    "env-check:prod": "node scripts/env-check.mjs --production",
    "env-check:vercel": "node scripts/env-check.mjs --production",
    "vercel-validate": "node scripts/vercel-validate.mjs",
    "local-validate": "node scripts/local-validate.mjs",
    "local-validate:fast": "node scripts/local-validate.mjs --skip-build",
    "ssr-validate": "node scripts/ssr-validate.mjs",
    "ssr-validate:fast": "node scripts/ssr-validate.mjs --skip-build",
    "ssr-runtime-validate": "node scripts/ssr-runtime-validate.mjs",
    "seo-validate": "node scripts/seo-validate-runtime.mjs",
    "seo-validate:runtime": "node scripts/seo-validate-runtime.mjs",
    "release-check": "node scripts/release-check.mjs",
    "smoke-check": "node scripts/smoke-check.mjs",
    "smoke-check:prod": "node scripts/smoke-check.mjs --production",
    "production-validate": "node scripts/production-validate.mjs",
    "production-validate:fast": "node scripts/production-validate.mjs --skip-build",
    "staging-validate": "node scripts/staging-validate.mjs",
    "staging-validate:fast": "node scripts/staging-validate.mjs --skip-build",
    "staging-validate:ci": "node scripts/staging-validate.mjs --allow-placeholders",
    "migration-validate": "node scripts/migration-validate.mjs",
    "auth-validate": "node scripts/auth-validate.mjs",
    "security-logs-validate": "node scripts/security-logs-validate.mjs",
    "security-headers-validate": "node scripts/security-headers-validate.mjs",
    "error-handling-validate": "node scripts/error-handling-validate.mjs",
    "monitoring-validate": "node scripts/monitoring-validate.mjs",
    "multi-tenant-auth-validate": "node scripts/multi-tenant-auth-validate.mjs",
    "seed-validate": "node scripts/seed-validate.mjs",
    "seed-validate:fix": "node scripts/seed-validate.mjs --fix",
    "pwa:generate": "node scripts/generate-pwa-assets.mjs",
    "pwa-validate": "node scripts/pwa-validate.mjs",
    "pwa-validate:dist": "node scripts/pwa-validate.mjs --dist",
    "branding-audit": "node scripts/branding-audit.mjs",
    "branding-audit:bundle": "node scripts/branding-audit.mjs --bundle"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tanstack/router-plugin": "^1.167.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "^3.0.260522-beta",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.7.3",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1"
  }
}
