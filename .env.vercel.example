# MedFlow-IA — Variáveis para deploy Vercel (painel ou CLI)
#
# Configure em: Project → Settings → Environment Variables
# Production + Preview conforme o ambiente.
#
# Build (Vite embute no bundle — prefixo VITE_):
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_MEDFLOW_APP_URL=https://seu-projeto.vercel.app
# VITE_MEDFLOW_CONTACT_EMAIL=contato@seudominio.com.br

# Servidor SSR / server functions (sem prefixo VITE_ — marque como Sensitive):
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# MEDFLOW_AUDIT_HASH_SALT=random_long_secret
# MEDFLOW_OPENAI_API_KEY=sk-...
# MEDFLOW_OPENAI_MODEL=gpt-4o-mini

# Opcional — proteção de preview / automation:
# VERCEL_AUTOMATION_BYPASS_SECRET=...

# Não definir em produção:
# VITE_MEDFLOW_DEBUG=1
